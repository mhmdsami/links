{
  "name": "links",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "gate": "bun run gate:api && bun run gate:web && bun run gate:app",
    "gate:api": "cd api && bun run gate",
    "gate:web": "cd web && bun run gate",
    "gate:app": "cd app && bun run gate",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2"
  }
}
