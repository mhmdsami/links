{
  "name": "links-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "types": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "gate": "npm run types && npm run test",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
