{
  "name": "links-api",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.4.4 <2"
  },
  "scripts": {
    "dev": "wrangler dev --port 3000",
    "deploy": "wrangler deploy",
    "generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply links-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply links-db --remote",
    "types": "tsc --noEmit",
    "test": "bun test",
    "gate": "bun run types && bun run test"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.7.1",
    "hono": "^4.13.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "4.156.0"
  }
}
